{
  "name": "peer-data",
  "version": "4.0.0",
  "description": "WebRTC data channels and media between browsers, one peer connection per participant, over the signaling you choose",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "examples": "vite --config examples/vite.config.ts",
    "prepare": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vardius/peer-data.git"
  },
  "keywords": [
    "webrtc",
    "rtcdatachannel",
    "rtcpeerconnection",
    "peer-to-peer",
    "p2p",
    "data-channel",
    "media-stream",
    "signaling",
    "socket.io"
  ],
  "author": {
    "name": "Rafał Lorenz",
    "email": "folksy.surges9p@icloud.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vardius/peer-data/issues"
  },
  "homepage": "https://vardius.github.io/peer-data/",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
